{
  "manifest_version": 2,
  "name": "LINE · aller au dossier",
  "version": "1.0.0",
  "description": "Un champ par-dessus le bandeau de LINE : taper un GCBLO (ARC500894-ACF010) puis Entrée ouvre son dossier. Rien d'autre.",
  "browser_specific_settings": {
    "gecko": {
      "id": "aller-line@rezenforge.github.io",
      "strict_min_version": "109.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "content_scripts": [
    {
      "matches": ["https://flashback.orange.fr/line/*"],
      "js": ["aller.js"],
      "run_at": "document_idle"
    }
  ]
}
